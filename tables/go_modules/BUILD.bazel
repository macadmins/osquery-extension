load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_modules",
    srcs = [
        "discover.go",
        "go_modules.go",
        "parse.go",
        "warnings.go",
    ],
    importpath = "github.com/macadmins/osquery-extension/tables/go_modules",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/devclients",
        "//pkg/fsscan",
        "//pkg/redact",
