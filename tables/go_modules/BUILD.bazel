go_test(
    name = "go_modules_test",
    srcs = [
        "bench_test.go",
        "go_modules_test.go",
        "parse_test.go",
        "refusal_unix_test.go",
        "refusal_windows_test.go",
    ],
    embed = [":go_modules"],
    deps = [
        "//pkg/devclients",
        "//pkg/fsscan",
        "//pkg/testutil",
        "//pkg/utils",
        "@com_github_osquery_osquery_go//plugin/table",
